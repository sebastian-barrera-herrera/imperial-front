# URL interna de la API. Next la usa para reenviar /api/* (se lee al hacer `next build`/`next dev`).
# El navegador solo habla con Next, así las cookies httpOnly son same-origin.
API_URL="http://localhost:4000"

# Marca y datos legales (opcionales). Se incrustan al compilar. Aparecen en las páginas de privacidad y en el pie.
# NEXT_PUBLIC_SITE_NAME="Tu Despacho"
# NEXT_PUBLIC_LEGAL_ENTITY="Razón social completa del despacho"
# NEXT_PUBLIC_LEGAL_ADDRESS="Dirección física del despacho"
# NEXT_PUBLIC_CONTACT_EMAIL="contacto@tudespacho.com"
# NEXT_PUBLIC_PRIVACY_EMAIL="privacidad@tudespacho.com"

# URL pública del sitio (para las imágenes al compartir en redes). Ej.: https://www.tudominio.com
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
